{
  "manifest_version": 3,
  "name": "Edgenuity AI Auto-Solver & Navigator",
  "version": "2.2.0",
  "description": "Fast parallel Free AI solver for Edgenuity quizzes and topic tests with auto-start, automatic video skip/play handling, and final-question auto-submit.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*.edgenuity.com/*",
    "*://*.imagineedgenuity.com/*",
    "https://api.kilo.ai/*",
    "https://api.llm7.io/*",
    "https://oai.endpoints.kepler.ai.cloud.ovh.net/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "http://localhost:11434/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Edgenuity AI Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.edgenuity.com/*",
        "*://*.imagineedgenuity.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}